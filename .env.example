# Copie para .env (que esta no .gitignore) e preencha.
# No GitHub, INSTAGRAM_* viram secrets e PUBLISH_ENABLED vira uma variable.

# Conta: @jamesolaya.es

# --- Instagram (necessario para publicar) --------------------------------
# Obtidos ao criar o app em developers.facebook.com com o produto Instagram
# ("API setup with Instagram login"). Permissoes: instagram_business_basic,
# instagram_business_content_publish, instagram_business_manage_insights.
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_API_VERSION=v26.0

# Trava de seguranca: nada e publicado enquanto isto nao for exatamente "true".
PUBLISH_ENABLED=false

# --- Geracao de legendas (so no Mac) -------------------------------------
# Usada apenas por 'jayes draft-captions'. NAO adicione como secret do
# GitHub: o runner publica legendas ja congeladas na fila e nunca chama a IA.
ANTHROPIC_API_KEY=
